# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets (Settings > Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Persistence & Auth Configuration
DATABASE_URL=""
AUTH_SECRET="pocketsmart_demo_secret_key"

# Optional External Platform Integrations (Leave blank to use AI Estimated Recommendations)
AMAZON_API_KEY=""
FLIPKART_API_KEY=""
IKEA_API_KEY=""
SWIGGY_API_KEY=""
ZOMATO_API_KEY=""
OYO_API_KEY=""

